# Server-side only. Store these in Supabase Edge Function Secrets.
# You can use ONE provider or all three. AI_PROVIDER=auto will use the first working provider and fall back when it fails.
AI_PROVIDER=auto
# Optional generic key/model. Use these only when AI_PROVIDER is gemini/openrouter/groq.
# AI_API_KEY=
# AI_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Optional image background removal provider (server-side only)
REMOVE_BG_API_KEY=

# Optional external market-price feed for SIH dynamic pricing (server-side only).
# Endpoint must return either a JSON array or {"items":[...]}; each item can contain title/category/material/price/date/source.
MARKET_PRICE_FEED_URL=
MARKET_PRICE_FEED_API_KEY=

# Optional government/e-commerce marketplace connector (server-side only).
# The endpoint must accept POST JSON in the Craft Connect connector envelope.
MARKETPLACE_SYNC_URL=
MARKETPLACE_SYNC_API_KEY=
